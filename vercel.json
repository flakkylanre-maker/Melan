{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/get",
      "destination": "https://play.google.com/store/apps/details?id=com.simi.melan&referrer=utm_source%3Dmelan.app%26utm_medium%3Dlink",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=com.simi.melan&referrer=utm_source%3Dmelan.app%26utm_medium%3Dlink",
      "permanent": false
    },
    {
      "source": "/iphone",
      "destination": "/#iphone",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-+FHbg4CIUZXW8yvJFXlKR/TKAb925Xh1BUxsQCPYf2M='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://vrlhoddvkkuslkatdtux.supabase.co; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
